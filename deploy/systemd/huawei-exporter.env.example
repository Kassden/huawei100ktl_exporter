# Recommended real inverter profile: RS485 / Modbus RTU
SUN2000_MODBUS_TRANSPORT=rtu
SUN2000_MODBUS_UNIT_ID=1
SUN2000_MODBUS_TIMEOUT=5.0
# On a Raspberry Pi 4B with a GPIO UART RS485 HAT, prefer /dev/serial0.
# Use /dev/ttyUSB0 only for a USB-to-RS485 adapter.
SUN2000_SERIAL_PORT=/dev/serial0
SUN2000_SERIAL_BAUDRATE=9600
SUN2000_SERIAL_PARITY=N
SUN2000_SERIAL_BYTESIZE=8
SUN2000_SERIAL_STOPBITS=1

# Optional TCP values for simulator or gateway-based testing
SUN2000_MODBUS_HOST=127.0.0.1
SUN2000_MODBUS_PORT=5020

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

INFLUXDB_URL=https://your-influxdb-cloud-url
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=your-org-name
INFLUXDB_BUCKET=inverters
INFLUXDB_MEASUREMENT=huawei_sun2000
INFLUXDB_TIMEOUT=30

DEVICE_ID=inverter_001
SITE_ID=site_001
COLLECTION_INTERVAL=60
UPLOAD_INTERVAL=60
BATCH_SIZE=10
RETRY_ATTEMPTS=3
RETRY_DELAY=5
EXPORTER_ENABLE_CONTROL=false
EXPORTER_STALE_AFTER_SECONDS=180

SPOOL_ENABLED=true
SPOOL_PATH=/var/lib/huawei-exporter/telemetry-spool.sqlite3
SPOOL_MAX_BYTES=1073741824
SPOOL_MIN_FREE_BYTES=536870912
SPOOL_BATCH_POINTS=100
SPOOL_BATCH_BYTES=262144
SPOOL_TARGET_DAYS=45

# Architecture boundary:
# Do not add weather, ambient context, shade context, or other cloud enrichment
# configuration to the edge exporter. Those jobs belong in cloud/backend services
# and should write separate measurements joined downstream.
